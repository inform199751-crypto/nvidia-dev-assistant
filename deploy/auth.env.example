# 複製成 deploy/auth.env 再填(auth.env 不進 git)。設定方式見 oauth2-proxy 文件。
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.example.com/
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 隨機 32 bytes:python -c "import secrets; print(secrets.token_urlsafe(24))"
OAUTH2_PROXY_COOKIE_SECRET=
# 只讓公司信箱登入
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_REDIRECT_URL=https://assistant.example.com/oauth2/callback
