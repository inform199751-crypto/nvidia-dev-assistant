# catalog = build.nvidia.com(PoC);nim = 地端 NIM 容器
LLM_BACKEND=catalog
# 只有 catalog 需要;到 build.nvidia.com 產生,開頭是 nvapi-
NVIDIA_API_KEY=
# agent 能讀的程式碼根目錄(工具不會碰這個目錄以外的檔案);相對路徑以本專案資料夾為準
AGENT_WORKSPACE=demo_workspace
# run_tests 用的沙箱映像:docker build -t dev-assistant-sandbox sandbox
# 正式環境換成預裝該 repo 相依套件的映像
SANDBOX_IMAGE=dev-assistant-sandbox
# save_document 存檔的位置(寫好的文件、翻譯、摘要);相對路徑以本專案資料夾為準
AGENT_OUTPUT=output
# 依難度選模型的緊急開關:設成 off 就整個關掉(不改 models.yaml);shadow / on 會蓋過 models.yaml 的設定
DIFFICULTY_ROUTING=
# 上網查資料(預設關閉):true 才會給 AI 上網工具,每次上網前都會先問你
# 注意:搜尋關鍵字和網址會送到外部網站;公司內網與本機網址一律拒絕
ALLOW_WEB=false
# 上網搜尋用 Tavily(tavily.com 註冊取得,開頭是 tvly-);沒填就只能讀指定的網址
TAVILY_API_KEY=
